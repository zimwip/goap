    {
      "type": "timeseries",
      "title": "Write calls, p95",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, op) (rate(goap_bench_op_duration_seconds_bucket{service_name=\"goap-bench\", outcome=\"ok\", op=~\"CommitEdits|CreateChange|ImpactNodeCreate|ImpactNodeCheckout|ImpactNodeUpdate|ImpactNodeReview|ImpactNodeReviewBatch|CommitChange|MergeChange|ImportDomain\"}[$__rate_interval])))",
          "legendFormat": "{{op}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
